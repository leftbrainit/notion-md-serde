{
  "name": "notion-md-serde",
  "version": "0.1.0",
  "description": "Bidirectional conversion between Notion-flavored Markdown and Notion API block JSON",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./serialize": {
      "types": "./dist/serialize.d.ts",
      "import": "./dist/serialize.js",
      "require": "./dist/serialize.cjs"
    },
    "./deserialize": {
      "types": "./dist/deserialize.d.ts",
      "import": "./dist/deserialize.js",
      "require": "./dist/deserialize.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:deno": "pnpm build && deno task test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18"
  }
}
